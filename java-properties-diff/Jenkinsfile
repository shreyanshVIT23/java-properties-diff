// propdiff CI (Multibranch Pipeline, configured in jenkins/casc.yaml).
// Every branch: tests, release zip, smoke test, archived zip + sha256; on Linux, and on Windows
// when the Windows agent is connected.
// Tags like v1.2.3: the same on both platforms, with version 1.2.3, kept as a release and
// uploaded to a draft GitHub Release (the tag must be pushed to GitHub first).
// This project lives in the java-properties-diff folder of the git root.

/** Runs the Maven wrapper with the Temurin JDK of the agent (see jenkins/agent.Dockerfile). */
def mvn(String args) {
  if (isUnix()) {
    // SSH sessions do not inherit the container's ENV, so set the build JDK here
    withEnv(['JAVA_HOME=/opt/temurin-17', 'PATH+JDK=/opt/temurin-17/bin']) {
      sh "sh ./mvnw -B -ntp ${args}"
    }
  } else {
    // The Windows agent (jenkins/windows-agent.ps1) passes on its own JAVA_HOME, a JDK 21+
    // with jpackage. The minimum Java of the app is still 17: maven.compiler.release in pom.xml
    bat "mvnw.cmd -B -ntp ${args}"
  }
}

/** jpackage needs a numeric version: v1.2.3 tags give 1.2.3, branch builds 0.0.<build>. */
def appVersion() {
  if (!env.TAG_NAME) {
    return "0.0.${env.BUILD_NUMBER}"
  }
  def version = tagVersion(env.TAG_NAME)
  if (version == null) {
    error("Release tags must look like v1.2.3, got '${env.TAG_NAME}'")
  }
  return version
}

/** The 1.2.3 of a v1.2.3 tag, or null. NonCPS: a regex Matcher cannot be serialized. */
@NonCPS
def tagVersion(String tag) {
  def match = tag =~ /^v(\d+(\.\d+){0,2})$/
  return match ? match[0][1] : null
}

pipeline {
  agent none

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
  }

  environment {
    // The GitHub repository releases go to. The checkout comes from file:///repo, so gh cannot
    // infer it from the git remote.
    GH_REPO = 'shreyanshVIT23/java-properties-diff'
  }

  stages {
    // Windows zips can only be built on Windows, by this PC when jenkins/windows-agent.ps1 runs.
    // Branch builds skip Windows when it is not connected; releases must have both zips.
    stage('Detect platforms') {
      steps {
        script {
          // nodesByLabel (pipeline-utility-steps) lists online nodes only, by default
          def windows = nodesByLabel(label: 'windows')
          env.WINDOWS_AGENT = windows ? 'true' : 'false'
          if (env.TAG_NAME && !windows) {
            error("Release ${env.TAG_NAME} needs the Windows agent: run "
                + 'pwsh jenkins/windows-agent.ps1 on Windows, then build this tag again')
          }
          echo(windows ? "Windows agent online (${windows.join(', ')}): building linux and windows"
              : 'No Windows agent online: building linux only')
        }
      }
    }

    stage('Build') {
      matrix {
        axes {
          axis {
            name 'PLATFORM'
            values 'linux', 'windows'
          }
        }
        // Checked before asking for an agent, so it never waits for a missing Windows agent
        when {
          beforeAgent true
          expression { PLATFORM == 'linux' || env.WINDOWS_AGENT == 'true' }
        }
        // Options run before the agent is allocated, so this includes waiting for it: a Windows
        // agent closed after 'Detect platforms' fails the cell instead of queueing it forever
        options {
          timeout(time: 20, unit: 'MINUTES')
        }
        agent { label "${PLATFORM}" }
        stages {
          stage('Verify') {
            steps {
              dir('java-properties-diff') {
                mvn('clean verify')
              }
            }
            post {
              always {
                junit(testResults: 'java-properties-diff/target/surefire-reports/*.xml',
                    allowEmptyResults: false)
              }
            }
          }
          stage('Package') {
            steps {
              dir('java-properties-diff') {
                // clean: re-shading an already shaded jar gives overlap warnings
                mvn("-Pdist -DskipTests -Dapp.version=${appVersion()} clean verify")
              }
            }
          }
          stage('Smoke test') {
            steps {
              dir('java-properties-diff') {
                script {
                  if (isUnix()) {
                    sh "sh scripts/smoke-test.sh target/propdiff-${appVersion()}-linux-x64.zip"
                  } else {
                    pwsh "./scripts/smoke-test.ps1 'target/propdiff-${appVersion()}-windows-x64.zip'; exit \$LASTEXITCODE"
                  }
                }
              }
            }
          }
          stage('Archive') {
            steps {
              // propdiff-*.zip* matches both the zip and its .sha256
              archiveArtifacts(artifacts: 'java-properties-diff/target/propdiff-*.zip*',
                  fingerprint: true, onlyIfSuccessful: true)
              script {
                // The Release stage runs on another agent and collects both platforms' files
                if (env.TAG_NAME) {
                  stash(name: "dist-${PLATFORM}",
                      includes: 'java-properties-diff/target/propdiff-*.zip*')
                }
              }
            }
          }
        }
      }
    }

    // Uploads both platforms' zips + .sha256 to a DRAFT GitHub Release; you publish it on GitHub.
    // The tag must already be pushed to GitHub and point to the built commit.
    stage('Release') {
      when {
        beforeAgent true
        buildingTag()
      }
      // gh is installed in the Linux agent image (jenkins/agent.Dockerfile)
      agent { label 'linux' }
      steps {
        script {
          // Kept forever: log rotation never deletes a release build or its zips
          currentBuild.keepLog = true
          currentBuild.description = "release ${env.TAG_NAME} (draft on GitHub)"
        }
        unstash 'dist-linux'
        unstash 'dist-windows'
        withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
          withEnv(["APP_VERSION=${appVersion()}"]) {
            dir('java-properties-diff') {
              // Single quotes: the shell expands the variables, so the token never enters Groovy
              sh 'sh scripts/github-release.sh "$TAG_NAME" "$APP_VERSION" "$GIT_COMMIT" target/propdiff-*.zip*'
            }
          }
        }
      }
    }
  }
}
